TZ=America/New_York

# Optional, only when building from source: install a specific @actual-app/api
# version (e.g. 26.11.0). Leave unset to use the version in package.json.
# ACTUAL_VERSION=

# Optional — normally set via the in-app setup wizard (config/config.json takes priority)
# PLAID_CLIENT_ID=...
# PLAID_SECRET=...
# PLAID_ENV=sandbox
# PLAID_DAYS_REQUESTED=90
# ACTUAL_SERVER_URL=http://actual-server:5006
# ACTUAL_PASSWORD=...
# ACTUAL_SYNC_ID=...
# CRON_SCHEDULE=0 8 * * *

# Optional sync-completion webhook (POSTed after every sync; leave unset to disable)
# SYNC_WEBHOOK_URL=https://example.com/hooks/plaid-actual-sync
# SYNC_WEBHOOK_SECRET=...  (optional; sent as the X-Webhook-Secret header)
